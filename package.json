{
  "name": "itsmesujan-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "itsmesujan — AI-native builder. Multi-page 3D portfolio: Vite + React 19 + React Three Fiber + GSAP ScrollTrigger + Lenis.",
  "scripts": {
    "dev": "vite",
